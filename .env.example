# Obligatorias. La aplicación no arranca sin ellas.
SECRET_KEY=
# El hash (scrypt o pbkdf2) contiene '$'. docker compose lee este fichero
# para su propia interpolación de variables, no solo para pasarlas al
# contenedor: duplica cada '$' como '$$' o el hash llega vacío/corrupto.
# Ejemplo: scrypt:32768:8:1$$salt$$hash
ADMIN_PASSWORD_HASH=
# Local: sqlite:///data/app.db | Producción: postgresql+psycopg://...
DATABASE_URL=sqlite:///data/app.db
FLASK_ENV=development
# En producción: fuerza HTTPS y cookies seguras
FORCE_HTTPS=false
